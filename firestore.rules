rules_version = '2';
// Quy tắc bảo mật Firestore cho Sổ tay Dự án Năng lượng.
// Dán toàn bộ nội dung này vào Firebase Console → Firestore Database → Rules → Publish.
// Thay UID_QUAN_TRI bằng UID quản trị (giống ADMIN_UIDS trong firebase-config.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in ['FGHJtWDW8RTqoL0m2gfFT3ntN1K3'];
    }

    match /attempts/{id} {
      // Người đã đăng nhập được xem kết quả (phục vụ bảng xếp hạng).
      allow read: if request.auth != null;

      // Chỉ tạo lượt thi của chính mình, dữ liệu phải hợp lệ.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','photo','key','topic','level','ranked','total','correct','score','duration','createdAt'])
        && request.resource.data.total is int && request.resource.data.total >= 1 && request.resource.data.total <= 40
        && request.resource.data.correct is int && request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10
        && request.resource.data.score >= request.resource.data.correct * 10.0 / request.resource.data.total - 0.06
        && request.resource.data.score <= request.resource.data.correct * 10.0 / request.resource.data.total + 0.06
        && request.resource.data.duration is int && request.resource.data.duration >= request.resource.data.total * 3
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time;

      // Không ai sửa kết quả; chỉ quản trị được xóa.
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
